{
  "name": "xigma-fonts-library",
  "version": "1.0.0",
  "description": "Standalone MSDF font-atlas generation pipeline for the xigma design-tool family",
  "type": "module",
  "private": true,
  "scripts": {
    "bake": "scripts/bake_font.sh",
    "fonts": "node scripts/pipeline.mjs",
    "fonts:catalog": "node scripts/fetch_google_fonts_catalog.mjs",
    "fonts:download": "node scripts/download_all_fonts.mjs",
    "fonts:bake-all": "node scripts/bake_all_fonts.mjs",
    "fonts:bake-small-caps": "node scripts/bake_small_caps.mjs",
    "fonts:bake-full-glyphs": "node scripts/bake_full_glyphs.mjs",
    "fonts:bake-glyph-blocks": "node scripts/bake_glyph_blocks.mjs",
    "fonts:previews": "node scripts/generate_all_previews.mjs",
    "fonts:manifest": "node scripts/generate_manifest.mjs",
    "fonts:previews-bundle": "python3 scripts/generate_previews_bundle.py",
    "fonts:deploy-build": "node scripts/build_deploy.mjs",
    "prefonts:serve": "node scripts/xigma-pull.cjs",
    "fonts:serve": "node scripts/serve.mjs",
    "postinstall": "node scripts/xigma-pull.cjs",
    "xigma:pull": "node scripts/xigma-pull.cjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xigma-application/xigma-fonts-library.git"
  },
  "license": "ISC",
  "dependencies": {
    "msdf-bmfont-xml": "^2.8.0"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0"
  }
}
